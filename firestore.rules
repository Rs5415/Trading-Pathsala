rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isAdminUserDoc(userData) {
      return 'role' in userData && userData.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         isAdminUserDoc(get(/databases/$(database)/documents/users/$(request.auth.uid)).data))
      );
    }

    function isApprovedOrderData(uid, batchId, ordData) {
      return 'studentUid' in ordData &&
        'courseId' in ordData &&
        'status' in ordData &&
        ordData.studentUid == uid &&
        ordData.courseId == batchId &&
        ordData.status == 'approved';
    }

    function isOrderApproved(uid, batchId, orderId) {
      return orderId is string &&
        orderId.size() > 0 &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        isApprovedOrderData(uid, batchId, get(/databases/$(database)/documents/orders/$(orderId)).data);
    }

    function isValidActiveEnrollmentData(uid, batchId, enrData) {
      return 'studentUid' in enrData &&
        'courseId' in enrData &&
        'active' in enrData &&
        'orderId' in enrData &&
        enrData.studentUid == uid &&
        enrData.courseId == batchId &&
        enrData.active == true &&
        isOrderApproved(uid, batchId, enrData.orderId);
    }

    // Strict verified purchase check (<= 4 doc reads total across enrollment + order)
    function hasVerifiedPurchase(uid, batchId) {
      return exists(/databases/$(database)/documents/enrollments/$(uid + '_' + batchId)) &&
        isValidActiveEnrollmentData(uid, batchId, get(/databases/$(database)/documents/enrollments/$(uid + '_' + batchId)).data);
    }

    // Strict schema check for batch links (title, description, url, batchId, published, timestamps only)
    function isValidBatchLink(data, batchId) {
      return data.keys().hasAll(['title', 'description', 'url', 'batchId', 'published', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'description', 'url', 'batchId', 'published', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
        data.url is string && data.url.size() >= 8 && data.url.size() <= 2000 &&
        data.url.matches('^https?://.*') &&
        data.batchId is string && data.batchId == batchId &&
        data.published is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Default-deny fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // ADMINS COLLECTION
    // =========================================================================
    match /admins/{adminId} {
      // Direct non-circular check: Any authenticated user can read their own admin doc
      allow get: if isSignedIn() && request.auth.uid == adminId;
      // Admins can list other admin accounts
      allow list: if isAdmin();
      // Only existing admins or initial Console provisioning can write to admins
      allow write: if isAdmin();
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      // User can read their own profile, or an admin can read any profile
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Student registration:
      // Must set their own uid as doc ID, must set role to 'student' (or must be admin already)
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'student' || isAdmin()
      );

      // Updates:
      // Owners can update their personal details, but cannot elevate role to 'admin' unless already admin
      // Admins can update any field
      allow update: if (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid
      ) || isAdmin();

      // Deletion only by admin
      allow delete: if isAdmin();
    }

    // =========================================================================
    // COURSES COLLECTION & BATCH-WISE PRIVATE LINKS SUBCOLLECTION
    // =========================================================================
    match /courses/{courseId} {
      // Public read so all visitors and prospective students can view catalog
      allow read: if true;

      // Only administrators can create, update, or delete courses
      allow write: if isAdmin();

      // Private batch-wise learning links: /courses/{courseId}/links/{linkId}
      match /links/{linkId} {
        // Admin can read all links; students can read ONLY published links for batches with a verified active purchase
        allow get: if isSignedIn() && isValidId(courseId) && isValidId(linkId) && (
          isAdmin() || (
            resource.data.published == true &&
            hasVerifiedPurchase(request.auth.uid, courseId)
          )
        );

        allow list: if isSignedIn() && isValidId(courseId) && (
          isAdmin() || (
            hasVerifiedPurchase(request.auth.uid, courseId) &&
            resource.data.published == true
          )
        );

        // Only administrators can create, update, publish/unpublish, or delete batch links
        allow create: if isAdmin() &&
          isValidId(courseId) &&
          isValidId(linkId) &&
          isValidBatchLink(request.resource.data, courseId) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;

        allow update: if isAdmin() &&
          isValidId(courseId) &&
          isValidId(linkId) &&
          isValidBatchLink(request.resource.data, courseId) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;

        allow delete: if isAdmin() && isValidId(courseId) && isValidId(linkId);
      }
    }

    // =========================================================================
    // ORDERS COLLECTION (UPI PAYMENT VERIFICATION)
    // Document ID is the globally unique 12-digit UTR (orders/{cleanUtr})
    // =========================================================================
    match /orders/{orderId} {
      // Students can read their own orders; admins can read all orders
      allow get: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());

      // Student creating an order (create-only submission using UTR as document ID):
      // 1. Must be authenticated
      // 2. studentUid must match auth.uid
      // 3. status must be 'pending'
      // 4. amount must be a positive number
      // 5. utr must be a 12-digit string matching the document ID {orderId}
      // 6. studentEmail, courseId, courseName, and whatsappNumber must be valid strings
      // Create-only submission guarantees atomic duplicate UTR protection without extra queries
      allow create: if isSignedIn() && (
        isAdmin() || (
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.utr is string &&
          request.resource.data.utr == orderId &&
          request.resource.data.utr.size() == 12 &&
          request.resource.data.studentEmail is string &&
          request.resource.data.courseId is string &&
          request.resource.data.courseName is string &&
          request.resource.data.whatsappNumber is string
        )
      );

      // Students can NEVER update or delete orders once placed; only admin can approve or reject
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // UTRS COLLECTION (DUPLICATE TRANSACTION PREVENTION)
    // =========================================================================
    match /utrs/{utrNumber} {
      // Any signed-in student can check if a UTR has already been submitted
      allow get: if isSignedIn();
      // Signed-in students can register their own UTR reference
      allow create: if isSignedIn() && (
        isAdmin() || (
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.utr == utrNumber
        )
      );
      // Only admins can delete or update UTR records
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // ENROLLMENTS COLLECTION
    // =========================================================================
    match /enrollments/{enrollmentId} {
      // Students can read their own course enrollments; admins can read all
      allow get: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());

      // Only administrators can grant or revoke course enrollments
      allow write: if isAdmin();
    }

    // =========================================================================
    // SETTINGS COLLECTION
    // =========================================================================
    match /settings/{settingId} {
      // Public read for general settings (UPI ID, payee name, instructions, address)
      allow read: if true;

      // Only administrators can change UPI ID, QR URL, or contact details
      allow write: if isAdmin();
    }

    // =========================================================================
    // OFFERS & NOTIFICATIONS COLLECTIONS
    // =========================================================================
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
